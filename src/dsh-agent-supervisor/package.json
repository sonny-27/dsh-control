{
  "name": "dsh-agent-supervisor",
  "version": "0.1.3-dsh021rc3.3",
  "description": "Scoped subagent sidebar, truthful plan progress and cooperative cascading stop for DSH.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-subagent",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dshMigration": {
    "unofficial": true,
    "target": "0.2.1-rc.2",
    "sourceVersion": "0.1.3-dsh021rc1.1",
    "cumulativeFixesPreserved": true
  }
}
